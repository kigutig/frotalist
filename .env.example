# ============================================================
# Shopping das Academias — Controle de Frota
# Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com suas credenciais do Supabase.
# NUNCA commit o arquivo .env no repositório.

# ---- SUPABASE ----
# Encontre estas credenciais em: https://app.supabase.com → Settings → API

# URL do seu projeto Supabase (ex: https://xyzabc.supabase.co)
VITE_SUPABASE_URL=

# Chave anon/public do projeto (segura para uso no frontend)
VITE_SUPABASE_ANON_KEY=

# ---- CONFIGURAÇÕES DA APLICAÇÃO ----

# Nome da empresa (exibido no sistema)
VITE_APP_NAME="Shopping das Academias — Controle de Frota"

# Modo de demonstração (true = sem Supabase, usa dados mock)
# Deixe vazio para usar Supabase real.
# VITE_DEMO_MODE=true
